{
  "name": "arabic-normalize",
  "version": "1.0.0",
  "description": "Normalisierung arabischer Schrift für den Vergleich: Vokalzeichen, koranische Marker, persische und Urdu-Buchstabenvarianten.",
  "keywords": [
    "arabic",
    "normalization",
    "quran",
    "persian",
    "urdu",
    "text-comparison",
    "nlp"
  ],
  "license": "MIT",
  "author": "Domenic Moran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DomenicMoran/arabic-normalize.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/DomenicMoran/arabic-normalize#readme",
  "bugs": {
    "url": "https://github.com/DomenicMoran/arabic-normalize/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
