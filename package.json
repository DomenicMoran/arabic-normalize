{
  "name": "arabic-normalize",
  "version": "1.0.0",
  "description": "Normalisierung arabischer Schrift für den Vergleich: Vokalzeichen, koranische Marker, persische und Urdu-Buchstabenvarianten.",
  "keywords": ["arabic", "normalization", "quran", "persian", "urdu", "text-comparison", "nlp"],
  "license": "MIT",
  "author": "Domenic Moran",
  "repository": { "type": "git", "url": "git+https://github.com/DomenicMoran/arabic-normalize.git" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "typescript": "^5.7.3", "vitest": "^3.0.5" },
  "engines": { "node": ">=20" }
}
